<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <BaseIntermediateOutputPath>obj~\</BaseIntermediateOutputPath>
        <BaseOutputPath>bin~\</BaseOutputPath>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>10</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <!-- NuGet authoring. PackageVersion is the single source of truth for nuget.org
         releases (upm/nuget workflows verify it matches the package.json UPM version).
         Svelto.Common dependency version is resolved from the ProjectReference. -->
    <PropertyGroup>
        <PackageId>Svelto.Tasks</PackageId>
        <Authors>Sebastiano Mandala</Authors>
        <PackageVersion>2.0.0-preview.5</PackageVersion>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/sebas77/Svelto.Tasks</PackageProjectUrl>
        <PackageDescription>Asynchronous Tasks handling and execution</PackageDescription>
        <PackageTags>svelto;ecs;unity;dots</PackageTags>
        <RepositoryUrl>https://github.com/sebas77/Svelto.Tasks</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\AGENTS.md" Pack="true" PackagePath="\" />
        <None Include="..\.aiguides\AI_GUIDE_Svelto.Tasks.md" Pack="true" PackagePath=".aiguides\" />
    </ItemGroup>

    <!--Opt-in profiling instrumentation (TaskProfiler + runner hooks). Debug builds are
        instrumented automatically so IDE F5 runs (e.g. Examples/23_ProfilerPlugin) can
        measure; pass -p:EnableTasksProfiler=true to instrument a Release build. The
        global property flows to referencing projects, so one flag covers both halves.
        Release default stays uninstrumented: the hooks add a lock + stopwatch per step.-->
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' Or '$(EnableTasksProfiler)' == 'true' ">
        <DefineConstants>$(DefineConstants);TASKS_PROFILER_ENABLED</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\com.sebaslab.svelto.common\Svelto.Common\Svelto.Common.csproj" />
    </ItemGroup>

</Project>
