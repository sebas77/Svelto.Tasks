<Project>
  <!--
    All projects must build into bin~/obj~ instead of bin/obj (Unity convention: ~ suffix marks generated folders).
    This file is imported before the SDK defaults BaseIntermediateOutputPath/MSBuildProjectExtensionsPath,
    so NuGet restore artifacts (project.assets.json etc.) also land in obj~ rather than obj.
    Per-project overrides in .csproj files intentionally repeat these values.
  -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj~\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin~\</BaseOutputPath>
  </PropertyGroup>
</Project>
