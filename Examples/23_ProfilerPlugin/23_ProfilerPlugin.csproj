<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj~\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin~\</BaseOutputPath>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>10</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <!--Must match the Svelto.Tasks build: Debug is instrumented automatically, so a
      plain IDE run (F5) measures. To measure a Release build, pass the msbuild
      property EnableTasksProfiler set to true; the global property flows to the
      referenced Svelto.Tasks project, compiling the profiler hooks into both.-->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' Or '$(EnableTasksProfiler)' == 'true' ">
    <DefineConstants>$(DefineConstants);TASKS_PROFILER_ENABLED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Packages\com.sebaslab.svelto.tasks\Svelto.Tasks\Svelto.Tasks.csproj" />
  </ItemGroup>
</Project>
